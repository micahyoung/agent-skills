#!/usr/bin/env python3
"""Gramps Python interpreter wrapper.

Acts like a python interpreter that can import the Gramps libraries. On
macOS it uses the native Gramps app bundle; on other systems (e.g. the
PyPI/venv install on Linux) it uses the gramps-enabled python found on PATH.

Usage:
    gramps_python -c "code"
    gramps_python script.py arg1 arg2
    echo "code" | gramps_python
"""
import os
import shutil
import sys

# Allow importing sibling _gramps_backend
sys.path.insert(0, os.path.dirname(__file__))
from _gramps_backend import find_gramps_app_resources

#: Candidate paths for Python 3.13, checked in order.
_PYTHON313_CANDIDATES = (
    "/opt/homebrew/bin/python3.13",
    "python3.13",  # resolves via shutil.which
)


def _find_python313() -> str | None:
    for path in _PYTHON313_CANDIDATES:
        if path.startswith("/"):
            if os.path.isfile(path) and os.access(path, os.X_OK):
                return path
        else:
            resolved = shutil.which(path)
            if resolved:
                return resolved
    return None


def _find_gramps_python() -> str | None:
    """Find a Python that can `import gramps` on non-macOS systems.

    Derived from the `gramps` CLI on PATH (e.g. an activated venv): the
    interpreter that runs the CLI can also import the gramps libraries.
    """
    gramps_bin = shutil.which("gramps")
    if not gramps_bin:
        return None
    candidate = os.path.join(os.path.dirname(os.path.realpath(gramps_bin)), "python")
    if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
        return candidate
    return None


def _bootstrap_dir() -> str:
    return os.path.join(os.path.dirname(__file__), "_gramps_python_bootstrap")


def _run_native(python_path: str, user_args: list[str]) -> None:
    resources = find_gramps_app_resources()
    if not resources:
        raise RuntimeError("Gramps app resources not found")
    lib_dir, sp_dir = resources

    env = os.environ.copy()

    # DYLD_LIBRARY_PATH: append Gramps lib dir
    old_dyld = env.get("DYLD_LIBRARY_PATH", "")
    env["DYLD_LIBRARY_PATH"] = lib_dir + (":" + old_dyld if old_dyld else "")

    # PYTHONPATH: bootstrap first (for sitecustomize), then Gramps site-packages
    bootstrap = _bootstrap_dir()
    old_py = env.get("PYTHONPATH", "")
    if old_py:
        env["PYTHONPATH"] = bootstrap + ":" + sp_dir + ":" + old_py
    else:
        env["PYTHONPATH"] = bootstrap + ":" + sp_dir

    # Hand over completely to native Python 3.13
    os.execve(python_path, [python_path] + user_args, env)


def main() -> None:
    user_args = sys.argv[1:]

    # macOS: native Python 3.13 + Gramps.app bundle resources.
    python_path = _find_python313()
    if python_path and find_gramps_app_resources():
        _run_native(python_path, user_args)
        return

    # Linux / other: a gramps-enabled python derived from the gramps CLI (venv).
    gramps_python = _find_gramps_python()
    if gramps_python:
        os.execve(gramps_python, [gramps_python] + user_args, os.environ.copy())
        return

    print(
        "Error: Gramps Python not available.\n\n"
        "Requires one of:\n"
        "  - macOS: Gramps.app bundle + Python 3.13 at /opt/homebrew/bin/python3.13, OR\n"
        "  - Linux: a gramps-enabled python on PATH (e.g. an activated venv from the\n"
        "           PyPI install — `source /home/user/gramps-venv/bin/activate`)\n",
        file=sys.stderr,
    )
    sys.exit(1)


if __name__ == "__main__":
    main()
