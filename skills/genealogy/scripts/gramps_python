#!/usr/bin/env python3
"""Gramps Python interpreter wrapper.

Acts like a python interpreter that can import the Gramps libraries.
Prefers native Gramps + Python 3.13 on macOS, falls back to Docker.

Usage:
    gramps_python -c "code"
    gramps_python script.py arg1 arg2
    echo "code" | gramps_python
"""
import os
import shutil
import sys

# Allow importing sibling _gramps_backend
sys.path.insert(0, os.path.dirname(__file__))
from _gramps_backend import DOCKER_IMAGE, find_gramps_app_resources

#: Candidate paths for Python 3.13, checked in order.
_PYTHON313_CANDIDATES = (
    "/opt/homebrew/bin/python3.13",
    "python3.13",  # resolves via shutil.which
)


def _find_python313() -> str | None:
    for path in _PYTHON313_CANDIDATES:
        if path.startswith("/"):
            if os.path.isfile(path) and os.access(path, os.X_OK):
                return path
        else:
            resolved = shutil.which(path)
            if resolved:
                return resolved
    return None


def _bootstrap_dir() -> str:
    return os.path.join(os.path.dirname(__file__), "_gramps_python_bootstrap")


def _run_native(python_path: str, user_args: list[str]) -> None:
    resources = find_gramps_app_resources()
    if not resources:
        raise RuntimeError("Gramps app resources not found")
    lib_dir, sp_dir = resources

    env = os.environ.copy()

    # DYLD_LIBRARY_PATH: append Gramps lib dir
    old_dyld = env.get("DYLD_LIBRARY_PATH", "")
    env["DYLD_LIBRARY_PATH"] = lib_dir + (":" + old_dyld if old_dyld else "")

    # PYTHONPATH: bootstrap first (for sitecustomize), then Gramps site-packages
    bootstrap = _bootstrap_dir()
    old_py = env.get("PYTHONPATH", "")
    if old_py:
        env["PYTHONPATH"] = bootstrap + ":" + sp_dir + ":" + old_py
    else:
        env["PYTHONPATH"] = bootstrap + ":" + sp_dir

    # Hand over completely to native Python 3.13
    os.execve(python_path, [python_path] + user_args, env)


def _run_docker(user_args: list[str]) -> None:
    cwd = os.getcwd()

    docker_flags = ["--rm"]
    if sys.stdin.isatty():
        docker_flags.append("-t")
    if not sys.stdin.isatty() or len(user_args) == 0:
        docker_flags.append("-i")

    cmd = (
        ["docker", "run"]
        + docker_flags
        + [
            "-v", f"{cwd}:/data",
            "-w", "/data",
            "--entrypoint", "python3",
            DOCKER_IMAGE,
        ]
        + user_args
    )

    os.execvp("docker", cmd)


def main() -> None:
    user_args = sys.argv[1:]

    python_path = _find_python313()
    if python_path and find_gramps_app_resources():
        _run_native(python_path, user_args)
    else:
        if not shutil.which("docker"):
            print(
                "Error: Gramps Python not available.\n\n"
                "Native mode requires:\n"
                "  - Gramps app bundle at /Applications/Gramps.app\n"
                "  - Python 3.13 at /opt/homebrew/bin/python3.13 (or in PATH)\n\n"
                "Docker fallback requires:\n"
                "  - Docker installed and the daemon running\n",
                file=sys.stderr,
            )
            sys.exit(1)
        _run_docker(user_args)


if __name__ == "__main__":
    main()
