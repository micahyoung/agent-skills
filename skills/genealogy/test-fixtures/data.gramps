  <notes>
    <note handle="_10345b4958d15f5d09c911d88b17" change="1781705587" id="N0000" type="Person Note">
      <text>Grandfather figure. Korean War veteran.</text>
    </note>
    <note handle="_10345b4958db1f22b5231ce05969" change="1781705587" id="N0001" type="Person Note">
      <text>Folk musician who left the family to tour for many years.</text>
    </note>
    <note handle="_10345b4958e03feca5d28f7ec8e3" change="1781705587" id="N0002" type="Person Note">
      <text>Dennis works the night shift at the grain elevator on Route 9.</text>
    </note>
    <note handle="_10345b4958e81e8db28d53c71995" change="1781705587" id="N0003" type="Person Note">
      <text>Known for her extensive hat collection.</text>
    </note>
    <note handle="_10345b4958ee29826b387b39cf6c" change="1781705587" id="N0004" type="Person Note">
      <text>Eldest child of Dennis and Lorraine.</text>
    </note>
    <note handle="_10345b4958f411cc89f28c0cb51d" change="1781705587" id="N0005" type="Person Note">
      <text>Accomplished student, plays the cello, volunteers at the animal shelter.</text>
    </note>
    <note handle="_10345b4958f9248f53c5f1593b5e" change="1781705587" id="N0006" type="Person Note">
      <text>Youngest Varnell child. Selectively mute.</text>
    </note>
    <note handle="_10345b4958ff42dd7cc5fc776aaa" change="1781705587" id="N0007" type="Person Note">
      <text>Father of Lorraine, Greta, and Faye.</text>
    </note>
    <note handle="_10345b49590339d07285e11fa4cd" change="1781705587" id="N0008" type="Person Note">
      <text>Mother of Lorraine, Greta, and Faye.</text>
    </note>
    <note handle="_10345b4959072272988e42b1a999" change="1781705587" id="N0009" type="Person Note">
      <text>Twin sister of Faye. Works at the post office.</text>
    </note>
    <note handle="_10345b49590d3b9cd66e3f51deaa" change="1781705587" id="N0010" type="Person Note">
      <text>Twin sister of Greta. Has been married multiple times.</text>
    </note>
    <note handle="_10345b4959127034f2073eb1da72" change="1781705587" id="N0011" type="Person Note">
      <text>Adopted daughter of Faye Decker.</text>
    </note>
    <note handle="_10345b49591913e1a66aa5262be4" change="1781705587" id="N0012" type="Person Note">
      <text>Dennis's half-brother. Former owner of Caine Woodworks.</text>
    </note>
    <note handle="_10345b49591c23a70c5e976d42f4" change="1781705587" id="N0013" type="Person Note">
      <text>Mother of Malcolm Caine. Had a brief relationship with Roderick Varnell.</text>
    </note>
    <note handle="_10345b4959253e791cc4dc49a906" change="1781705587" id="N0014" type="Family Note">
      <text>The Varnell nuclear family.</text>
    </note>
    <note handle="_10345b4959275ff49b61a2a8b8dd" change="1781705587" id="N0015" type="Family Note">
      <text>Roderick Varnell's earlier relationship before Estelle.</text>
    </note>
    <note handle="_10345b49592d72033c3046ec8903" change="1781705587" id="N0016" type="Family Note">
      <text>Faye as single adoptive parent.</text>
    </note>
  </notes>
</database>
